# From https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Optional: portable session. Omit (leave empty) to log in interactively on first run.
# WARNING: a session string grants FULL access to your account. Never commit it.
SESSION_STRING=

# Where state.json + the .session file live. Default: current directory.
# Docker/Railway: use /data (mounted volume).
DATA_DIR=.

# Command prefix. Default: .  (commands become .gc add, .gc list, ...)
HANDLER_PREFIX=.

LOG_LEVEL=INFO
